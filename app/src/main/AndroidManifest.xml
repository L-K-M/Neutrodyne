<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Unlicense -->
<!-- :app's own manifest (01 Manifest and permissions, M0a subset). android:debuggable is never written here. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Requested contextually only, never at launch -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- ACRA's mail hand-off (09) -->
  <queries>
    <intent>
      <action android:name="android.intent.action.SENDTO" />
      <data android:scheme="mailto" />
    </intent>
  </queries>

  <application
    android:name=".NeutrodyneApplication"
    android:allowBackup="true"
    android:appCategory="audio"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:enableOnBackInvokedCallback="true"
    android:fullBackupContent="@xml/backup_rules"
    android:hasFragileUserData="true"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:networkSecurityConfig="@xml/network_security_config"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/Theme.Neutrodyne"
    tools:targetApi="37">

    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:launchMode="singleTop"
      android:theme="@style/Theme.Neutrodyne.Starting"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- WorkManager is configured by NeutrodyneApplication (Configuration.Provider); ProfileInstaller stays -->
    <provider
      android:name="androidx.startup.InitializationProvider"
      android:authorities="${applicationId}.androidx-startup"
      android:exported="false"
      tools:node="merge">
      <meta-data
        android:name="androidx.work.WorkManagerInitializer"
        android:value="androidx.startup"
        tools:node="remove" />
    </provider>

    <!-- AppCompat stores the per-app language on API < 33 (09 Shipped locales and per-app language) -->
    <service
      android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
      android:enabled="false"
      android:exported="false">
      <meta-data
        android:name="autoStoreLocales"
        android:value="true" />
    </service>
  </application>

</manifest>
