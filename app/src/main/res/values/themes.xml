<!-- AppCompat themes (01 Application element and components): AppCompatActivity needs an AppCompat theme; the
     splash theme stays on MainActivity only. Colours come from NeutrodyneTheme once Compose draws. -->
<resources>
  <color name="brand_navy">#FF00192E</color>

  <style name="Theme.Neutrodyne" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowBackground">@android:color/transparent</item>
  </style>

  <style name="Theme.Neutrodyne.Translucent" parent="Theme.Neutrodyne">
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowAnimationStyle">@null</item>
  </style>

  <style name="Theme.Neutrodyne.Starting" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/brand_navy</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_neutrodyne</item>
    <item name="postSplashScreenTheme">@style/Theme.Neutrodyne</item>
  </style>
</resources>
