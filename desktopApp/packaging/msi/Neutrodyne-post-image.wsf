<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Unlicense

     Neutrodyne-post-image.wsf — jpackage's post-image hook for the Windows MSI
     (11 AOT cache, Windows MSI). JDK 25's packaging pipeline copies the app
     image into its private staging tree without COPY_ATTRIBUTES
     (PackagingPipeline.copyAppImage → PathGroup.copy), so every staged file's
     modification time becomes the packaging time and the trained archive's
     recorded classpath-JAR timestamps no longer match: a strict
     -XX:AOTMode=on launch would fail before main with "timestamp has changed".
     The supported <app name>-post-image.wsf hook runs on that staging copy
     after the copy and before WiX builds the MSI; this script restores the
     fixed epoch trainAotCache wrote. Written against the pinned JDK 25
     pipeline sources; jpackage's own templates are GPL-2.0+CE and never copied
     (D3). It fails closed: an invalid staging context or a file timestamp
     that cannot be set aborts the packaging rather than ship an installer
     whose strict cache fails.

     JScript, not VBScript, so the path read from the environment is data:
     it travels through FileSystemObject/Shell method arguments and is never
     concatenated into executable command text. Spaces and Unicode survive.
     The epoch is UTC — 318211200000 ms (1980-02-01T00:00:00Z), the
     AOT_IMAGE_TIMESTAMP_MS the training task wrote; new Date(ms) builds the
     Date from the UTC instant, so the local-time components the Shell applies
     are correct in any packaging timezone. -->
<package>
  <job id="neutrodyne-post-image">
    <script language="JScript"><![CDATA[
var epochMs = 318211200000;
var reparsePoint = 0x400;

try {
    var dir = WScript.Environment("Process").Item("JpAppImageDir");
    if (dir === null || dir === undefined || dir === "") {
        throw new Error("JpAppImageDir is not set");
    }

    var fso = new ActiveXObject("Scripting.FileSystemObject");
    if (!fso.FolderExists(dir)) {
        throw new Error("JpAppImageDir is not a staging directory: " + dir);
    }

    // On Windows the standard pipeline keeps JpAppImageDir at the staging
    // root; the install tree sits below the --install-dir value
    // (installationPath = "Neutrodyne-App", 11 Windows MSI and ZIP). Require
    // the trained layout — the launcher, its .cfg with the -XX:AOTCache read
    // flag, the trained archive and the classpath JARs whose timestamps the
    // archive recorded. Packaging without them would ship a strict-mode
    // failure, so the hook refuses instead of silently passing through.
    var app = dir + "\\Neutrodyne-App";
    var cfg = app + "\\app\\Neutrodyne.cfg";
    var aot = app + "\\app\\neutrodyne.aot";
    if (!fso.FolderExists(app)) {
        throw new Error("no staged install tree at " + app);
    }
    if (!fso.FileExists(app + "\\Neutrodyne.exe")) {
        throw new Error("no staged launcher at " + app + "\\Neutrodyne.exe");
    }
    if (!fso.FileExists(cfg)) {
        throw new Error("no staged launcher config at " + cfg);
    }
    if (!fso.FileExists(aot)) {
        throw new Error("no trained AOT archive at " + aot);
    }
    var cfgText = fso.OpenTextFile(cfg, 1, false, 0).ReadAll();
    if (cfgText.indexOf("java-options=-XX:AOTCache=$APPDIR/neutrodyne.aot") < 0) {
        throw new Error("the staged .cfg carries no -XX:AOTCache read flag");
    }
    var appDir = fso.GetFolder(app + "\\app");
    var hasJar = false;
    var jars = new Enumerator(appDir.Files);
    for (; !jars.atEnd(); jars.moveNext()) {
        var candidate = jars.item();
        if (candidate.Name.match(/\.jar$/i)) {
            hasJar = true;
            break;
        }
    }
    if (!hasJar) {
        throw new Error("no classpath JARs under " + app + "\\app");
    }

    // Restore the fixed epoch on every staged file and directory — the same
    // value the trained image carries — so the WiX payload records it.
    // Symbolic links (reparse points) are skipped entirely: their targets are
    // never followed and their own timestamps stay untouched, matching
    // trainAotCache's normalization. File timestamps are fatal (the strict
    // cache checks them); a directory timestamp that the Shell cannot set is
    // reported but does not abort the packaging, because the cache binds only
    // files and the MSI's installed directories are created at install time.
    var shell = new ActiveXObject("Shell.Application");
    var epoch = new Date(epochMs);

    function setFolderTime(path) {
        var parent = fso.GetParentFolderName(path);
        var name = fso.GetFileName(path);
        var item = shell.Namespace(parent).ParseName(name);
        if (item !== null && item !== undefined) {
            try {
                item.ModifyDate = epoch;
            } catch (e) {
                WScript.Echo("Neutrodyne-post-image: cannot set the folder timestamp for " + path + ": " + e.message);
            }
        }
    }

    function walk(folder) {
        var files = new Enumerator(folder.Files);
        for (; !files.atEnd(); files.moveNext()) {
            var file = files.item();
            if ((file.Attributes & reparsePoint) === 0) {
                file.DateLastModified = epoch;
            }
        }
        var subs = new Enumerator(folder.SubFolders);
        for (; !subs.atEnd(); subs.moveNext()) {
            var sub = subs.item();
            if ((sub.Attributes & reparsePoint) === 0) {
                walk(sub);
                setFolderTime(sub.Path);
            }
        }
    }

    walk(fso.GetFolder(dir));
    setFolderTime(dir);
    WScript.Quit(0);
} catch (e) {
    WScript.Echo("Neutrodyne-post-image: " + e.message);
    WScript.Quit(1);
}
    ]]></script>
  </job>
</package>
