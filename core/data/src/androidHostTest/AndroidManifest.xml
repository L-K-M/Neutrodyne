<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- The same ${applicationId}.fileprovider authority shape as :app, over the same
         cache/export root, so ExportShareUrisTest's positive legs run the real FileProvider
         resolution — test-only authority, never shipped. -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="ch.lkmc.neutrodyne.core.data.test.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/test_file_paths" />
    </provider>
  </application>
</manifest>
