# SPDX-License-Identifier: Unlicense
# Include these directives in your existing TLS server block.
# Match the server's 2 MiB wire-request cap, including compressed requests.
client_max_body_size 2m;
# HSTS is the proxy's job; the app sends the other security headers itself.
# add_header is inherited only by locations that set none of their own, so it
# stays at this level: a location-level add_header would hide every
# server-level header, yours included, from that location. Skip this line when
# the server block already adds Strict-Transport-Security.
add_header Strict-Transport-Security "max-age=31536000" always;
location /api/v1/events {
    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
location / {
    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
