  <string name="sync_share_passwords">Share feed passwords</string>
  <string name="sync_share_passwords_hint">Lets your other devices refresh private feeds that need a password. Passwords already shared stay on the server until you change a feed's password or delete your data there.</string>
  <string name="sync_share_passwords_title">Share feed passwords?</string>
  <string name="sync_share_passwords_body">The passwords of your private feeds are stored on %1$s in readable form so your other devices can use them. Anyone who can read the server's data can read them.</string>
  <string name="sync_share_passwords_confirm">Share</string>
