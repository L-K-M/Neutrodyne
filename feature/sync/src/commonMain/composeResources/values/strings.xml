<resources>
  <string name="sync_title">Sync</string>
  <string name="sync_intro">Keep your podcasts in step on your phone and computers with a Neutrodyne Sync server you run yourself. Without one, everything works as now.</string>
  <string name="sync_continue">Continue</string>
  <string name="sync_linked">Linked to %1$s</string>
  <string name="sync_now">Sync now</string>
  <string name="sync_activity_idle">Live updates idle</string>
  <string name="sync_activity_syncing">Syncing…</string>
  <string name="sync_activity_live">Live updates connected</string>
  <string name="sync_what_syncs">Synced: subscriptions (including private feed links), groups and their order, played state, positions, favourites, Up next, what’s playing, podcast and group playback settings, and (with Sync playback settings) your playback defaults. Not synced: downloads and audio files, artwork, automatic downloads, storage, notifications, refresh schedule, appearance, the YouTube engine and update settings.</string>
  <string name="sync_reconnect">Reconnect to %1$s</string>
  <string name="sync_reconnect_body">This copy of Neutrodyne isn't linked yet. Nothing has been synced since it was restored or copied.</string>
  <string name="sync_finish_link">Finish linking to %1$s.</string>
  <string name="sync_revoked">This device was unlinked from %1$s.</string>
  <string name="sync_server_address">Server address</string>
  <string name="sync_run_server">How to run a server</string>
  <string name="sync_reconnect_action">Reconnect</string>
  <string name="sync_link_again">Link again</string>
  <string name="sync_forget_server">Forget server</string>
  <string name="sync_forget_stale">The saved link changed while the server was being forgotten. Nothing was cleared; check the status above.</string>
  <string name="sync_forget_failed">The server couldn't be forgotten. The saved sync data is unchanged.</string>
  <string name="sync_forget_unexpected">Something went wrong while forgetting the server. Check the status above, then try again.</string>

  <string name="sync_setup_title">Link a device</string>
  <string name="sync_setup_address_hint">sync.example.org</string>
  <string name="sync_setup_checking">Checking %1$s…</string>
  <string name="sync_setup_linking">Linking…</string>
  <string name="sync_setup_cancel">Cancel</string>
  <string name="sync_setup_try_again">Try again</string>
  <string name="sync_setup_done">Done</string>
  <string name="sync_setup_disclosure_title">What %1$s will store</string>
  <string name="sync_setup_disclosure_body">Your subscriptions%1$s, your groups, Up next, listening history and synced settings. Whoever runs the server can read them: Neutrodyne Sync doesn\'t encrypt them end to end. Feed passwords are stored only if you turn on Share feed passwords. Audio, downloads and artwork are never sent.</string>
  <string name="sync_setup_private_feeds">, including %1$d private feed links</string>
  <string name="sync_setup_encrypted">The connection is encrypted (HTTPS).</string>
  <string name="sync_setup_not_encrypted">The connection isn\'t encrypted (http).</string>
  <string name="sync_setup_method_code">Link code</string>
  <string name="sync_setup_method_invite">Invite code</string>
  <string name="sync_setup_method_password">Password</string>
  <string name="sync_setup_get_code">Get a code</string>
  <string name="sync_setup_invite_label">Invite code (16 characters)</string>
  <string name="sync_setup_username_label">Username</string>
  <string name="sync_setup_password_label">Password</string>
  <string name="sync_setup_code_lead">On a device that\'s already linked, open Settings › Sync › Link another device and enter this code. Or open %1$s in a browser and sign in.</string>
  <string name="sync_setup_upload_title">Upload this library to %1$s?</string>
  <string name="sync_setup_upload_body">This account has no podcasts or groups yet. Everything on this device is uploaded to %1$s.</string>
  <string name="sync_setup_upload_confirm">Upload</string>
  <string name="sync_setup_choice_title">Combine this device with %1$s</string>
  <string name="sync_setup_choice_merge">Merge (recommended)</string>
  <string name="sync_setup_choice_merge_body">Keep everything from both. This device: %1$d podcasts, %2$d groups. %3$s: %4$d podcasts, %5$d groups.</string>
  <string name="sync_setup_choice_server">Use the server\'s library on this device</string>
  <string name="sync_setup_choice_server_body">Replaces this device\'s podcasts, groups, listening history and Up next with the server\'s.</string>
  <string name="sync_setup_choice_device">Use this device\'s library everywhere</string>
  <string name="sync_setup_choice_device_body">Replaces the library on the server and on your other devices with this device\'s.</string>
  <string name="sync_setup_replace_server_title">Replace this device’s library?</string>
  <string name="sync_setup_replace_server_body">Podcasts and groups that aren’t on the server are removed here, and listening history and Up next are replaced.</string>
  <string name="sync_setup_replace_server_backup">Save a backup first</string>
  <string name="sync_setup_replace_server_confirm">Replace</string>
  <string name="sync_setup_replace_device_title">Use this device’s library everywhere?</string>
  <string name="sync_setup_replace_device_body">Other devices will remove podcasts and groups this device doesn’t have when they next sync; devices ask first when this exceeds their limits.</string>
  <string name="sync_setup_replace_device_confirm">Replace everywhere</string>
  <string name="sync_setup_backup_working">Saving backup…</string>
  <string name="sync_setup_backup_saved">Backup saved.</string>
  <string name="sync_setup_merging_uploading">Uploading…</string>
  <string name="sync_setup_merging_downloading">Downloading…</string>
  <string name="sync_setup_merging">Combining your libraries… %1$d of %2$d</string>
  <string name="sync_setup_linked_done">This device is linked to %1$s as %2$s.</string>
  <string name="sync_setup_local_network_title">Allow access to your local network?</string>
  <string name="sync_setup_local_network_body">%1$s is on your local network. Android asks whether Neutrodyne may connect to devices on it. Neutrodyne uses this only for your sync server; podcast feeds on your local network stay unsupported.</string>
  <string name="sync_setup_local_network_denied">Neutrodyne can\'t reach %1$s without local-network access. Allow it for Neutrodyne in Android\'s app settings, or use the server\'s public address.</string>
  <string name="sync_setup_insecure_title">This connection isn\'t encrypted</string>
  <string name="sync_setup_insecure_body">%1$s uses http://. Anyone on your network can read what Neutrodyne sends to it, including your subscriptions and the key that links this device. Continue only on a network you trust.</string>
  <string name="sync_setup_connect_anyway">Connect anyway</string>
  <string name="sync_error_offline">Changes are kept and sent when you\'re back online.</string>
  <string name="sync_error_unreachable">Can\'t reach %1$s.</string>
  <string name="sync_error_certificate">%1$s\'s certificate isn\'t trusted. Neutrodyne accepts certificates from public authorities such as Let\'s Encrypt; self-signed certificates aren\'t supported.</string>
  <string name="sync_error_local_network">Neutrodyne needs local-network access to reach %1$s.</string>
  <string name="sync_error_revoked">This device was unlinked from %1$s. Its library is unchanged.</string>
  <string name="sync_error_app_too_old">%1$s needs a newer version of Neutrodyne.</string>
  <string name="sync_error_server_too_old">%1$s runs an older Neutrodyne Sync server that this version can\'t use. Ask its administrator to update it.</string>
  <string name="sync_error_wrong_password">Wrong username or password.</string>
  <string name="sync_error_invalid_code">That code isn\'t valid or has expired.</string>
  <string name="sync_error_link_declined">The link was declined on the other device.</string>
  <string name="sync_error_invite_invalid">This invite code isn\'t valid any more. Ask your administrator for a new one.</string>
  <string name="sync_error_merge_failed">Linking didn\'t finish. Your library is unchanged; continue in Settings › Sync.</string>
  <string name="sync_error_rate_limited">Too many attempts. Try again in a few minutes.</string>
  <string name="sync_error_server">%1$s reported an error (%2$d). Neutrodyne tries again later.</string>
  <string name="sync_error_insecure_transport">Neutrodyne only connects to servers on the internet over https://.</string>
  <string name="sync_error_clock_skew">This device's date and time are off, so its changes can't be ordered. Set the clock automatically, then sync again.</string>
  <string name="sync_error_quota">Your account on %1$s is full. Ask its administrator.</string>
  <string name="sync_error_not_a_server">%1$s isn\'t a Neutrodyne Sync server. Check the address.</string>
  <string name="sync_error_device_gone">That device is already gone.</string>

