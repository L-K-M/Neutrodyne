# SPDX-License-Identifier: Unlicense
# Copy to .env to override the defaults. First-run setup creates the admin
# account through the web UI, so no password or token goes here.

# To allow a phone on a trusted home network, set the server's LAN IP instead.
# Use brackets for IPv6 addresses, for example [::1].
NEUTRODYNE_BIND_ADDRESS=127.0.0.1
NEUTRODYNE_PORT=8787

# Set false to disable the daily GitHub release check.
NEUTRODYNE_SERVER_UPDATE_CHECK=true

# For a reverse proxy that terminates HTTPS, uncomment all three settings.
# The empty TRANSPORT value switches off the default --insecure-lan flag.
# Set the trusted proxy to the peer IP or CIDR the server container sees.
# A proxy on the Docker host will generally appear as the project network's
# gateway. Find it with docker network inspect <project>_default.
# NEUTRODYNE_SERVER_PUBLIC_URL=https://sync.example.org
# NEUTRODYNE_SERVER_TRANSPORT=
# NEUTRODYNE_SERVER_TRUSTED_PROXIES=
